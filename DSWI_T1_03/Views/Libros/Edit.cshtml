@model DSWI_T1_03.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="container mt-5">

    <h2>Editar Libro</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="LibroId" />

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Genero" class="form-label">Género</label>
            <input asp-for="Genero" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="AñoPublicacion" class="form-label">Año de publicación</label>
            <input asp-for="AñoPublicacion" class="form-control" type="number" />
        </div>

        <div class="mb-3">
            <label asp-for="Isbn" class="form-label">ISBN</label>
            <input asp-for="Isbn" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="AutorId" class="form-label">Autor</label>

            <select asp-for="AutorId"
                    asp-items="ViewBag.Autores"
                    class="form-select">
                <option value="">Seleccione un autor</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Actualizar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>

    </form>

</div>
