@model DSWI_T1_01.ViewModels.BecaViewModel
@{
    ViewData["Title"] = "Cálculo de Nota Final y Beca";
}

<div class="container mt-4" style="max-width: 550px;">
    <h3>Evaluación Instituto de Idiomas</h3>
    <form asp-action="Beca" method="post" class="card p-4 shadow-sm">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Nota 1:</label>
                <input asp-for="Nota1" type="number" step="0.01" min="0" max="20" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Nota 2:</label>
                <input asp-for="Nota2" type="number" step="0.01" min="0" max="20" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Nota 3:</label>
                <input asp-for="Nota3" type="number" step="0.01" min="0" max="20" class="form-control" required />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Porcentaje de Asistencia (%):</label>
            <input asp-for="Asistencia" type="number" step="0.1" min="0" max="100" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Evaluar Estudiante</button>
    </form>

    @if (Model.Calculado)
    {
        <div class="alert alert-info mt-3">
            <p class="mb-1"><strong>Promedio Final:</strong> @Model.Promedio</p>
            <p class="mb-1"><strong>Categoría:</strong> @Model.Categoria</p>
            <p class="mb-0"><strong>Porcentaje de Beca:</strong> @Model.PorcentajeBeca%</p>
        </div>
    }
</div>